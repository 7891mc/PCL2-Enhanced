<local:MyPageRight x:Class="PageDownloadCart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,0,0,15" Title="">
                <StackPanel Margin="12,10">
                    <TextBlock Text="模组购物车" FontSize="17" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.6" Text="将资源逐个加入购物车后，可在此处一次安装到当前版本；目标版本为「下载」页当前选择的版本。" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanList" />
            <local:MyCard Margin="0,15,0,0" x:Name="PanBottom">
                <StackPanel Orientation="Horizontal" Margin="14,12">
                    <local:MyButton x:Name="BtnInstall" MinWidth="140" Height="32" Text="开始安装" ColorType="Highlight" />
                    <local:MyButton x:Name="BtnClear" MinWidth="110" Height="32" Margin="10,0,0,0" Text="清空购物车" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" Opacity="0">
                <StackPanel Margin="20,17">
                    <TextBlock HorizontalAlignment="Center" Text="购物车是空的" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,9,0,0" Text="前往「下载」页面的资源详情，点击「加入购物车」即可批量安装。" Opacity="0.6" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
