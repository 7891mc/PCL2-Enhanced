<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageInstanceBackup"
    PanScroll="PanBack">
    <Grid x:Name="PanAllBack">
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Margin="25,10,25,65">
                <local:MyHint x:Name="HintBackup" Margin="0,15,0,0" Text="备份管理：将版本文件夹打包为 Zip 备份，可随时恢复。恢复操作会覆盖当前版本中的同名文件。" />
                <local:MyCard Margin="0,15" MinHeight="58">
                    <StackPanel Margin="22,8,25,8">
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnBackup" MinWidth="160" Text="备份当前版本" Padding="13,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnRefresh" MinWidth="110" Text="刷新列表" Padding="13,0" Margin="10,0,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
                <StackPanel x:Name="PanList" />
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
