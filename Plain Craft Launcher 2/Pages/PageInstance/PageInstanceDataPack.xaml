<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageInstanceDataPack"
    PanScroll="PanBack">
    <Grid x:Name="PanAllBack">
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Margin="25,10,25,65">
                <local:MyHint x:Name="HintDataPack" Margin="0,15,0,0" Text="数据包管理：管理当前版本 `datapacks` 文件夹中的数据包。数据包需要在新世界中通过 `/datapack enable` 启用，或在创建世界时开启。" />
                <local:MyCard Margin="0,15" MinHeight="58">
                    <StackPanel Margin="22,8,25,8">
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnInstall" MinWidth="150" Text="安装数据包" Padding="13,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnOpenFolder" MinWidth="130" Text="打开文件夹" Padding="13,0" Margin="10,0,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
                <StackPanel x:Name="PanList" />
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
