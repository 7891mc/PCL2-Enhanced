<local:MyPageRight x:Class="PageSetupSkin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PCL"
      mc:Ignorable="d" d:DesignWidth="960" Margin="0,60,0,5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">
            <local:MyCard Title="皮肤绘制器" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="CanvasHost" Width="640" Height="640" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image x:Name="SkinImage" Width="640" Height="640" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseLeftButtonDown="SkinImage_MouseLeftButtonDown" MouseMove="SkinImage_MouseMove"
                               MouseLeftButtonUp="SkinImage_MouseLeftButtonUp" MouseLeave="SkinImage_MouseLeave" />
                        <Canvas x:Name="GridCanvas" Width="640" Height="640" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="颜色" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                        <UniformGrid x:Name="PaletteGrid" Columns="4" Width="200" />
                        <Border x:Name="PanColorShow" Width="200" Height="26" Margin="0,8,0,0" Background="#FF3C3F41" CornerRadius="4" />
                        <TextBlock Text="工具" FontSize="13" FontWeight="Bold" Margin="0,14,0,6" />
                        <WrapPanel>
                            <local:MyButton x:Name="BtnBrush" Text="画笔" Width="64" Height="30" Margin="0,0,8,8" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnEraser" Text="橡皮" Width="64" Height="30" Margin="0,0,8,8" />
                            <local:MyButton x:Name="BtnFill" Text="填充" Width="64" Height="30" Margin="0,0,8,8" />
                            <local:MyButton x:Name="BtnPick" Text="取色" Width="64" Height="30" Margin="0,0,8,8" />
                            <local:MyButton x:Name="BtnClear" Text="清空" Width="64" Height="30" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="操作" FontSize="13" FontWeight="Bold" Margin="0,14,0,6" />
                        <WrapPanel>
                            <local:MyButton x:Name="BtnLoad" Text="载入皮肤" Width="80" Height="30" Margin="0,0,8,8" />
                            <local:MyButton x:Name="BtnSave" Text="保存 PNG" Width="80" Height="30" Margin="0,0,8,8" />
                            <local:MyButton x:Name="BtnUpload" Text="上传皮肤" Width="80" Height="30" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="说明：画笔与橡皮为 1×1 像素；填充会替换相邻同色区域；上传皮肤需先登录微软账号。" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Title="盔甲预览" Margin="0,0,0,15">
                <Grid>
                    <Canvas x:Name="PrevCanvas" Width="64" Height="148" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" />
                    <StackPanel Margin="90,0,0,0">
                        <TextBlock Text="选择盔甲类型，可在左侧预览穿戴后的效果（仅视觉预览）" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <WrapPanel>
                            <local:MyRadioButton x:Name="BtnArmorNone" Text="无盔甲" Checked="True" Tag="0" Margin="0,0,12,6" />
                            <local:MyRadioButton x:Name="BtnArmorIron" Text="铁甲" Tag="1" Margin="0,0,12,6" />
                            <local:MyRadioButton x:Name="BtnArmorGold" Text="金甲" Tag="2" Margin="0,0,12,6" />
                            <local:MyRadioButton x:Name="BtnArmorDiamond" Text="钻甲" Tag="3" Margin="0,0,12,6" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </ScrollViewer>
</local:MyPageRight>
